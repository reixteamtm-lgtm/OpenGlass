<Application x:Class="LiquidGlassStudio.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
  <Application.Resources>
    <!-- Màu động: đổi lúc chạy theo chất liệu kính / màu nhấn (tab Cài đặt) -->
    <SolidColorBrush x:Key="AccentBrush" Color="#0A84FF"/>
    <SolidColorBrush x:Key="SwitchOn" Color="#30D158"/>
    <SolidColorBrush x:Key="ContentBg" Color="#1C1C1E"/>
    <SolidColorBrush x:Key="SidebarBg" Color="#26262A"/>
    <SolidColorBrush x:Key="CardBg" Color="#2C2C2E"/>
    <SolidColorBrush x:Key="CardLine" Color="#14FFFFFF"/>
    <SolidColorBrush x:Key="RowLine" Color="#1AFFFFFF"/>
    <SolidColorBrush x:Key="LogBg" Color="#0CFFFFFF"/>
    <FontFamily x:Key="Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <Style TargetType="Button">
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="Background" Value="#2EFFFFFF"/>
      <Setter Property="Padding" Value="14,7"/>
      <Setter Property="Margin" Value="0,0,8,8"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FontWeight" Value="Medium"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}" RenderTransformOrigin="0.5,0.5"
                    BorderBrush="#1AFFFFFF" BorderThickness="0,1,0,0">
              <Border.RenderTransform><ScaleTransform ScaleX="1" ScaleY="1"/></Border.RenderTransform>
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Trigger.EnterActions><BeginStoryboard><Storyboard>
                  <DoubleAnimation Storyboard.TargetName="b" Storyboard.TargetProperty="Opacity" To="0.85" Duration="0:0:0.15"/>
                </Storyboard></BeginStoryboard></Trigger.EnterActions>
                <Trigger.ExitActions><BeginStoryboard><Storyboard>
                  <DoubleAnimation Storyboard.TargetName="b" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2"/>
                </Storyboard></BeginStoryboard></Trigger.ExitActions>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Trigger.EnterActions><BeginStoryboard><Storyboard>
                  <DoubleAnimation Storyboard.TargetName="b" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="0.95" Duration="0:0:0.08"/>
                  <DoubleAnimation Storyboard.TargetName="b" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="0.95" Duration="0:0:0.08"/>
                </Storyboard></BeginStoryboard></Trigger.EnterActions>
                <Trigger.ExitActions><BeginStoryboard><Storyboard>
                  <DoubleAnimation Storyboard.TargetName="b" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.3">
                    <DoubleAnimation.EasingFunction><ElasticEase Oscillations="1" Springiness="5" EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                  </DoubleAnimation>
                  <DoubleAnimation Storyboard.TargetName="b" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.3">
                    <DoubleAnimation.EasingFunction><ElasticEase Oscillations="1" Springiness="5" EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                  </DoubleAnimation>
                </Storyboard></BeginStoryboard></Trigger.ExitActions>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="b" Property="Opacity" Value="0.4"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Accent" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
    </Style>
    <Style x:Key="Danger" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="#D93A30"/>
    </Style>
    <Style x:Key="Light" TargetType="Button">
      <Setter Property="Width" Value="12"/><Setter Property="Height" Value="12"/>
      <Setter Property="Margin" Value="0,0,8,0"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid>
              <Ellipse x:Name="e" Fill="{TemplateBinding Background}" Stroke="#26000000" StrokeThickness="0.5"/>
              <TextBlock x:Name="g" Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" FontFamily="{StaticResource Icons}" FontSize="7" Foreground="#99000000"
                         HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="g" Property="Opacity" Value="1"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Sidebar kiểu System Settings: ô icon màu bo góc + chữ, chọn = nền màu nhấn -->
    <Style TargetType="ListBoxItem">
      <Setter Property="Foreground" Value="#E5E5EA"/>
      <Setter Property="Padding" Value="7,5"/>
      <Setter Property="Margin" Value="10,1"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Grid>
              <Border x:Name="hv" CornerRadius="7" Background="#14FFFFFF" Opacity="0"/>
              <Border x:Name="sel" CornerRadius="7" Background="{DynamicResource AccentBrush}" Opacity="0"/>
              <ContentPresenter Margin="{TemplateBinding Padding}"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Trigger.EnterActions><BeginStoryboard><Storyboard>
                  <DoubleAnimation Storyboard.TargetName="hv" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12"/>
                </Storyboard></BeginStoryboard></Trigger.EnterActions>
                <Trigger.ExitActions><BeginStoryboard><Storyboard>
                  <DoubleAnimation Storyboard.TargetName="hv" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2"/>
                </Storyboard></BeginStoryboard></Trigger.ExitActions>
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter Property="Foreground" Value="White"/>
                <Trigger.EnterActions><BeginStoryboard><Storyboard>
                  <DoubleAnimation Storyboard.TargetName="sel" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.18"/>
                </Storyboard></BeginStoryboard></Trigger.EnterActions>
                <Trigger.ExitActions><BeginStoryboard><Storyboard>
                  <DoubleAnimation Storyboard.TargetName="sel" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18"/>
                </Storyboard></BeginStoryboard></Trigger.ExitActions>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="NavHeader" TargetType="ListBoxItem">
      <Setter Property="IsEnabled" Value="False"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <TextBlock Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" Foreground="#8E8E93" FontSize="11" FontWeight="SemiBold" Margin="20,14,0,4"/>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="NavIcon" TargetType="Border">
      <Setter Property="Width" Value="22"/><Setter Property="Height" Value="22"/>
      <Setter Property="CornerRadius" Value="6"/><Setter Property="Margin" Value="0,0,10,0"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="NavGlyph" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource Icons}"/>
      <Setter Property="FontSize" Value="12"/><Setter Property="Foreground" Value="White"/>
      <Setter Property="HorizontalAlignment" Value="Center"/><Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="NavText" TargetType="TextBlock">
      <Setter Property="VerticalAlignment" Value="Center"/><Setter Property="FontSize" Value="13"/>
    </Style>

    <!-- Nhóm kiểu "inset grouped list" của Apple -->
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource CardBg}"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Padding" Value="16,8"/>
      <Setter Property="Margin" Value="0,0,0,16"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="BorderBrush" Value="{DynamicResource CardLine}"/>
    </Style>
    <Style x:Key="H1" TargetType="TextBlock">
      <Setter Property="FontSize" Value="26"/><Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Margin" Value="0,0,0,4"/>
      <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI"/>
    </Style>
    <Style x:Key="H2" TargetType="TextBlock">
      <Setter Property="FontSize" Value="15"/><Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Margin" Value="0,6,0,8"/>
    </Style>
    <Style x:Key="Section" TargetType="TextBlock">
      <Setter Property="FontSize" Value="13"/><Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="#B4EBEBF5"/>
      <Setter Property="Margin" Value="6,6,0,7"/><Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="Sub" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#A1A1A6"/><Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="Margin" Value="0,6,0,10"/><Setter Property="LineHeight" Value="19"/>
    </Style>
    <Style x:Key="RowSub" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#98989D"/><Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="FontSize" Value="12"/><Setter Property="Margin" Value="0,2,0,0"/>
    </Style>
    <Style x:Key="Input" TargetType="TextBox">
      <Setter Property="Background" Value="#33000000"/><Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderBrush" Value="#26FFFFFF"/><Setter Property="CaretBrush" Value="White"/>
      <Setter Property="Padding" Value="8,6"/><Setter Property="FontFamily" Value="Cascadia Mono, Consolas"/>
      <Setter Property="AcceptsReturn" Value="True"/><Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
      <Setter Property="Margin" Value="0,0,0,8"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="7">
              <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Nút gạt kiểu iOS cho mọi CheckBox: chữ bên trái, công tắc bên phải, kẻ mảnh giữa các dòng -->
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="#F2F2F7"/>
      <Setter Property="Margin" Value="0"/>
      <Setter Property="Padding" Value="0,9"/>
      <Setter Property="BorderThickness" Value="0,0,0,1"/>
      <Setter Property="BorderBrush" Value="{DynamicResource RowLine}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Border Background="Transparent" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <ContentPresenter VerticalAlignment="Center" Margin="0,0,16,0" RecognizesAccessKey="False">
                  <ContentPresenter.Resources>
                    <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
                  </ContentPresenter.Resources>
                </ContentPresenter>
                <Grid Grid.Column="1" Width="40" Height="24" VerticalAlignment="Center">
                  <Border CornerRadius="12" Background="#52787880"/>
                  <Border x:Name="on" CornerRadius="12" Background="{DynamicResource SwitchOn}" Opacity="0"/>
                  <Border x:Name="knob" Width="20" Height="20" CornerRadius="10" Background="White" HorizontalAlignment="Left" Margin="2,0,0,0"
                          BorderBrush="#26000000" BorderThickness="0.5"/>
                </Grid>
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="on" Property="Opacity" Value="1"/>
                <Setter TargetName="knob" Property="Margin" Value="18,0,0,0"/>
                <Trigger.EnterActions><BeginStoryboard><Storyboard>
                  <DoubleAnimation Storyboard.TargetName="on" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.18"/>
                  <ThicknessAnimation Storyboard.TargetName="knob" Storyboard.TargetProperty="Margin" To="18,0,0,0" Duration="0:0:0.3">
                    <ThicknessAnimation.EasingFunction><BackEase Amplitude="0.3" EasingMode="EaseOut"/></ThicknessAnimation.EasingFunction>
                  </ThicknessAnimation>
                </Storyboard></BeginStoryboard></Trigger.EnterActions>
                <Trigger.ExitActions><BeginStoryboard><Storyboard>
                  <DoubleAnimation Storyboard.TargetName="on" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18"/>
                  <ThicknessAnimation Storyboard.TargetName="knob" Storyboard.TargetProperty="Margin" To="2,0,0,0" Duration="0:0:0.3">
                    <ThicknessAnimation.EasingFunction><BackEase Amplitude="0.3" EasingMode="EaseOut"/></ThicknessAnimation.EasingFunction>
                  </ThicknessAnimation>
                </Storyboard></BeginStoryboard></Trigger.ExitActions>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Lựa chọn 1 trong nhiều: dòng danh sách, dấu ✓ màu nhấn bên phải (như Settings của iOS) -->
    <Style TargetType="RadioButton">
      <Setter Property="Foreground" Value="#F2F2F7"/>
      <Setter Property="Margin" Value="0"/>
      <Setter Property="Padding" Value="0,9"/>
      <Setter Property="BorderThickness" Value="0,0,0,1"/>
      <Setter Property="BorderBrush" Value="{DynamicResource RowLine}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border Background="Transparent" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="28"/></Grid.ColumnDefinitions>
                <ContentPresenter VerticalAlignment="Center" Margin="0,0,12,0" RecognizesAccessKey="False">
                  <ContentPresenter.Resources>
                    <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
                  </ContentPresenter.Resources>
                </ContentPresenter>
                <TextBlock x:Name="chk" Grid.Column="1" Text="&#xE73E;" FontFamily="{StaticResource Icons}" FontSize="14" FontWeight="Bold"
                           Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" Opacity="0"/>
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="chk" Property="Opacity" Value="1"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <!-- Segmented control (nhiều nút liền nhau) -->
    <Style x:Key="Seg" TargetType="RadioButton">
      <Setter Property="Foreground" Value="#F2F2F7"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="bd" CornerRadius="6" Padding="14,5" Background="Transparent">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="bd" Property="Background" Value="#5A636366"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="SegBox" TargetType="Border">
      <Setter Property="Background" Value="#33000000"/><Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Padding" Value="2"/><Setter Property="HorizontalAlignment" Value="Left"/>
      <Setter Property="Margin" Value="0,8,0,8"/>
    </Style>
    <!-- Ô màu nhấn (như macOS Appearance) -->
    <Style x:Key="Swatch" TargetType="RadioButton">
      <Setter Property="Cursor" Value="Hand"/><Setter Property="Margin" Value="0,0,12,0"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Grid Width="24" Height="24">
              <Ellipse Fill="{TemplateBinding Background}" Stroke="#33FFFFFF" StrokeThickness="1"/>
              <Ellipse x:Name="dot" Width="8" Height="8" Fill="White" Visibility="Collapsed"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True"><Setter TargetName="dot" Property="Visibility" Value="Visible"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Nhóm thu gọn được (disclosure) -->
    <Style x:Key="Group" TargetType="Expander">
      <Setter Property="Foreground" Value="#F2F2F7"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Expander">
            <StackPanel>
              <ToggleButton IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" Cursor="Hand" Focusable="False" HorizontalAlignment="Left">
                <ToggleButton.Template>
                  <ControlTemplate TargetType="ToggleButton">
                    <Border Background="Transparent" Padding="6,6,12,7"><ContentPresenter/></Border>
                  </ControlTemplate>
                </ToggleButton.Template>
                <StackPanel Orientation="Horizontal">
                  <ContentPresenter ContentSource="Header" VerticalAlignment="Center">
                    <ContentPresenter.Resources>
                      <Style TargetType="TextBlock">
                        <Setter Property="FontSize" Value="13"/><Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="Foreground" Value="#B4EBEBF5"/>
                      </Style>
                    </ContentPresenter.Resources>
                  </ContentPresenter>
                  <TextBlock x:Name="chevR" Text="&#xE76C;" FontFamily="{StaticResource Icons}" FontSize="9" Foreground="#8E8E93" Margin="8,1,0,0" VerticalAlignment="Center"/>
                  <TextBlock x:Name="chevD" Text="&#xE70D;" FontFamily="{StaticResource Icons}" FontSize="9" Foreground="#8E8E93" Margin="8,1,0,0" VerticalAlignment="Center" Visibility="Collapsed"/>
                </StackPanel>
              </ToggleButton>
              <ContentPresenter x:Name="body" Visibility="Collapsed"/>
            </StackPanel>
            <ControlTemplate.Triggers>
              <Trigger Property="IsExpanded" Value="True">
                <Setter TargetName="body" Property="Visibility" Value="Visible"/>
                <Setter TargetName="chevR" Property="Visibility" Value="Collapsed"/>
                <Setter TargetName="chevD" Property="Visibility" Value="Visible"/>
                <Trigger.EnterActions><BeginStoryboard><Storyboard>
                  <DoubleAnimation Storyboard.TargetName="body" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.25"/>
                </Storyboard></BeginStoryboard></Trigger.EnterActions>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Thanh trượt -->
    <Style x:Key="SliderFill" TargetType="RepeatButton">
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RepeatButton">
        <Border Height="4" CornerRadius="2" Background="{DynamicResource AccentBrush}"/>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="SliderRest" TargetType="RepeatButton">
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RepeatButton">
        <Border Height="4" CornerRadius="2" Background="#40FFFFFF"/>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="MacSlider" TargetType="Slider">
      <Setter Property="IsMoveToPointEnabled" Value="True"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Slider">
        <Track x:Name="PART_Track" Height="24">
          <Track.DecreaseRepeatButton><RepeatButton Style="{StaticResource SliderFill}" Command="{x:Static Slider.DecreaseLarge}"/></Track.DecreaseRepeatButton>
          <Track.IncreaseRepeatButton><RepeatButton Style="{StaticResource SliderRest}" Command="{x:Static Slider.IncreaseLarge}"/></Track.IncreaseRepeatButton>
          <Track.Thumb>
            <Thumb>
              <Thumb.Template><ControlTemplate TargetType="Thumb">
                <Ellipse Width="20" Height="20" Fill="White">
                  <Ellipse.Effect><DropShadowEffect BlurRadius="5" ShadowDepth="1" Opacity="0.3" Direction="270"/></Ellipse.Effect>
                </Ellipse>
              </ControlTemplate></Thumb.Template>
            </Thumb>
          </Track.Thumb>
        </Track>
      </ControlTemplate></Setter.Value></Setter>
    </Style>

    <!-- Thanh cuộn mảnh kiểu macOS -->
    <Style TargetType="ScrollBar">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Width" Value="10"/><Setter Property="MinWidth" Value="10"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
        <Track x:Name="PART_Track" IsDirectionReversed="True">
          <Track.Thumb>
            <Thumb>
              <Thumb.Template><ControlTemplate TargetType="Thumb">
                <Border x:Name="t" Width="6" CornerRadius="3" Background="#45FFFFFF" HorizontalAlignment="Center"/>
                <ControlTemplate.Triggers>
                  <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="t" Property="Background" Value="#80FFFFFF"/></Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate></Thumb.Template>
            </Thumb>
          </Track.Thumb>
        </Track>
      </ControlTemplate></Setter.Value></Setter>
      <Style.Triggers>
        <Trigger Property="Orientation" Value="Horizontal">
          <Setter Property="Width" Value="Auto"/><Setter Property="MinWidth" Value="0"/>
          <Setter Property="Height" Value="10"/><Setter Property="MinHeight" Value="10"/>
          <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
            <Track x:Name="PART_Track" IsDirectionReversed="False">
              <Track.Thumb>
                <Thumb>
                  <Thumb.Template><ControlTemplate TargetType="Thumb">
                    <Border Height="6" CornerRadius="3" Background="#45FFFFFF" VerticalAlignment="Center"/>
                  </ControlTemplate></Thumb.Template>
                </Thumb>
              </Track.Thumb>
            </Track>
          </ControlTemplate></Setter.Value></Setter>
        </Trigger>
      </Style.Triggers>
    </Style>
  </Application.Resources>
</Application>
